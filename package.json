{
  "name": "trace",
  "private": true,
  "version": "0.5.11",
  "productName": "TRACE",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "NODE_ENV=production tsx server.ts",
    "build": "vite build",
    "build:electron-server": "node scripts/build-electron-server.mjs",
    "build:web": "npm run build && npm run build:electron-server && node scripts/build-web-package.mjs",
    "web:start": "node scripts/start-public-web.mjs",
    "web:private": "node scripts/start-web.mjs",
    "web:build": "npm run build && node scripts/build-electron-server.mjs --public-web",
    "prepare:platform": "node scripts/prepare-platform-runtime.mjs",
    "electron:mac": "npm run build && npm run build:electron-server && node scripts/build-macos-installer.mjs",
    "electron:dev": "electron .",
    "electron:dist": "npm run build && npm run build:electron-server && node scripts/build-windows-installer.mjs",
    "electron:competition": "node scripts/build-competition-installer.mjs",
    "electron:portable": "npm run build && npm run build:electron-server && electron-builder --win portable",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron release",
    "lint": "tsc --noEmit",
    "test": "vitest run --pool threads --maxWorkers 1 --minWorkers 1"
  },
  "build": {
    "appId": "com.trace.desktop",
    "productName": "TRACE",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/**/*",
      "!electron/**/*.test.*",
      "skills/**/*",
      "!skills/**/.skill-index.json",
      "!skills/**/__pycache__/**",
      "lsf_skills/**/*",
      "donau_skills/**/*",
      "pipelines/**/*",
      "third-party/**/*",
      "!pipelines/**/__pycache__/**",
      "!pipelines/**/test_*.py",
      "demo-assets/**/*",
      "package.json",
      "vendor/**/*",
      "!vendor/dsh/node_modules/node-pty/prebuilds/darwin-arm64",
      "!vendor/dsh/node_modules/node-pty/prebuilds/darwin-x64",
      "!vendor/dsh/node_modules/node-pty/prebuilds/linux-arm64",
      "!vendor/dsh/node_modules/node-pty/prebuilds/linux-x64",
      "!vendor/dsh/node_modules/node-pty/prebuilds/win32-arm64",
      "!vendor/dsh/node_modules/@img/sharp-wasm32"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "guid": "89cfe10e-df55-5d54-bd62-1401b68111e1",
      "installerLanguages": [
        "en_US",
        "zh_CN"
      ],
      "oneClick": false,
      "include": "build/installer.nsh",
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "TRACE",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false
    },
    "asarUnpack": [
      "vendor/**/*",
      "skills/**/*",
      "demo-assets/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "peacezha",
        "repo": "TRACE"
      }
    ]
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.82",
    "@ai-sdk/openai": "^3.0.71",
    "@ai-sdk/openai-compatible": "^2.0.50",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^5.0.4",
    "@xterm/addon-fit": "^0.11.0",
    "adm-zip": "^0.5.16",
    "ai": "^6.0.206",
    "clsx": "^2.1.1",
    "docx-preview": "^0.4.0",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.9",
    "elkjs": "0.12.0",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.3",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "ssh2": "^1.17.0",
    "svg-captcha": "^1.4.0",
    "tailwind-merge": "^3.5.0",
    "tar": "^7.5.1",
    "undici": "7.30.0",
    "uuid": "^13.0.0",
    "vite": "^6.2.0",
    "ws": "^8.21.3",
    "xlsx": "^0.18.5",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/adm-zip": "^0.5.7",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.2",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.4"
  }
}
